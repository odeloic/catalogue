diff --git a/lib/widgets/export.rb b/lib/widgets/export.rb
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/lib/widgets/export.rb
@@ -0,0 +1,26 @@
+require 'csv'
+
+module Widgets
+  class Export
+    HEADER = %w[id name sku owner_email created_at].freeze
+
+    def initialize(scope)
+      @scope = scope
+    end
+
+    def to_csv
+      CSV.generate do |csv|
+        csv << HEADER
+        @scope.each do |widget|
+          csv << row_for(widget)
+        end
+      end
+    end
+
+    private
+
+    def row_for(widget)
+      [widget.id, widget.name, widget.sku, widget.owner.email, widget.created_at]
+    end
+  end
+end
diff --git a/app/controllers/widgets_controller.rb b/app/controllers/widgets_controller.rb
