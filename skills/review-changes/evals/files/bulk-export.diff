--- a/app/controllers/widgets_controller.rb
+++ b/app/controllers/widgets_controller.rb
@@ -1,8 +1,17 @@
 class WidgetsController < ApplicationController
   before_action :authenticate_user!, only: [:index, :show]

   def index
     @widgets = current_user.widgets
   end
+
+  def bulk_export
+    scope = Widget.where(tenant_id: params[:tenant_id])
+    csv = Widgets::Export.new(scope).to_csv
+    send_data csv, filename: "widgets-#{params[:tenant_id]}.csv"
+  end
 end
